{
    "name": "حسابي - نظام إدارة المبيعات",
    "short_name": "حسابي",
    "description": "نظام إدارة المبيعات والمخزون والمحاسبة - يعمل بدون إنترنت",
    "id": "/distribution-system/",
    "start_url": "./index.html",
    "scope": "./",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
    "orientation": "any",
    "background_color": "#0f172a",
    "theme_color": "#4f46e5",
    "lang": "ar",
    "dir": "rtl",
    "categories": ["business", "productivity", "finance"],
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "./icons/icon-72x72.png",
            "sizes": "72x72",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-96x96.png",
            "sizes": "96x96",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-128x128.png",
            "sizes": "128x128",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-144x144.png",
            "sizes": "144x144",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-152x152.png",
            "sizes": "152x152",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-384x384.png",
            "sizes": "384x384",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-maskable-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "./icons/icon-maskable-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "./icons/icon-monochrome.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "monochrome"
        }
    ],
    "shortcuts": [
        {
            "name": "نقطة البيع",
            "short_name": "بيع",
            "description": "بدء عملية بيع جديدة",
            "url": "./pos.html",
            "icons": [
                {
                    "src": "./icons/shortcut-pos.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "لوحة التحكم",
            "short_name": "الرئيسية",
            "description": "عرض الإحصائيات والملخصات",
            "url": "./dashboard.html",
            "icons": [
                {
                    "src": "./icons/shortcut-dashboard.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "الفواتير",
            "short_name": "الفواتير",
            "description": "عرض سجل الفواتير",
            "url": "./invoices.html",
            "icons": [
                {
                    "src": "./icons/shortcut-invoices.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "المنتجات",
            "short_name": "المنتجات",
            "description": "إدارة المنتجات والمخزون",
            "url": "./products.html",
            "icons": [
                {
                    "src": "./icons/shortcut-products.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        }
    ],
    "screenshots": [
        {
            "src": "./screenshots/dashboard-desktop.png",
            "sizes": "1920x1080",
            "type": "image/png",
            "form_factor": "wide",
            "label": "لوحة التحكم على الكمبيوتر"
        },
        {
            "src": "./screenshots/pos-desktop.png",
            "sizes": "1920x1080",
            "type": "image/png",
            "form_factor": "wide",
            "label": "نقطة البيع على الكمبيوتر"
        },
        {
            "src": "./screenshots/pos-mobile.png",
            "sizes": "750x1334",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "نقطة البيع على الجوال"
        },
        {
            "src": "./screenshots/dashboard-mobile.png",
            "sizes": "750x1334",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "لوحة التحكم على الجوال"
        }
    ],
    "file_handlers": [
        {
            "action": "./pos.html",
            "accept": {
                "application/json": [".json"]
            },
            "icons": [
                {
                    "src": "./icons/icon-192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ],
            "launch_type": "single-client"
        }
    ],
    "launch_handler": {
        "client_mode": ["navigate-existing", "auto"]
    },
    "handle_links": "preferred",
    "edge_side_panel": {
        "preferred_width": 480
    },
    "protocol_handlers": [
        {
            "protocol": "web+hesaby",
            "url": "./pos.html?action=%s"
        }
    ],
    "share_target": {
        "action": "./pos.html",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "backup",
                    "accept": ["application/json", ".json"]
                }
            ]
        }
    },
    "scope_extensions": [
        {
            "type": "origin",
            "origin": "https://itqanpos.github.io"
        }
    ],
    "iarc_rating_id": "",
    "related_applications": []
}
